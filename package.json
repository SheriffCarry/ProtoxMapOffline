{
  "name": "offline-protoxmapmaker",
  "version": "1.0.0",
  "description": "Offline client for Protox Mapmaker",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "build": {
    "appId": "com.protox.offline-mapmaker",
    "productName": "offline-protoxmapmaker",
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "artifactName": "${productName}-win-setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-win-portable-${version}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ]
    },
    "appImage": {
      "artifactName": "${productName}-linux-portable-${version}.${ext}"
    },
    "deb": {
      "artifactName": "${productName}-linux-setup-${version}.${ext}"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "artifactName": "${productName}-mac-portable-${version}.${ext}"
    },
    "dmg": {
      "artifactName": "${productName}-mac-setup-${version}.${ext}"
    }
  },
  "keywords": [],
  "author": "AI Generated <info@example.com>",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "axios": "^1.13.2",
    "fs-extra": "^11.3.2"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.12"
  }
}
